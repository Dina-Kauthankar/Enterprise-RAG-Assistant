# Enterprise Knowledge Assistant - Environment Configuration

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_assistant

# Security & Auth
SECRET_KEY=enterprise-knowledge-assistant-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration
# Options: "gemini" or "openai"
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# Embeddings & Reranking Models
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_THRESHOLD=0.0

# Document Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

